# Copy to .env and fill in. Never commit .env.

# How the internet reaches this machine (see docs/home-hosting.md):
#   direct: ports 80/443 forwarded here, Caddy does HTTPS (default)
#   tunnel: a Cloudflare Tunnel, no open ports
# Add ",ddns" to keep a Cloudflare DNS record pointed at a changing home IP.
COMPOSE_PROFILES=direct

# The public host name, e.g. pinstripe.social (DNS must point here).
PINSTRIPE_HOST=pinstripe.social
POSTGRES_PASSWORD=change-me-to-something-long

# open or closed
REGISTRATIONS=open

# Email (confirmation and password-reset links). Any SMTP provider.
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM=Pinstripe <noreply@pinstripe.social>

# Media: local disk (the "media" volume) or any S3-compatible bucket.
MEDIA_STORAGE=local
# MEDIA_STORAGE=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.pinstripe.social
# S3_FORCE_PATH_STYLE=false

# Only if the Expo project requires authenticated pushes.
# EXPO_ACCESS_TOKEN=

# COMPOSE_PROFILES=tunnel: the tunnel's token from the Cloudflare dashboard.
# TUNNEL_TOKEN=
# COMPOSE_PROFILES=direct,ddns: a Cloudflare API token with DNS edit rights.
# CLOUDFLARE_API_TOKEN=
