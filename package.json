{
  "name": "pinstripe",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r --if-present lint",
    "dev:server": "pnpm --filter @pinstripe/server dev",
    "dev:mobile": "pnpm --filter @pinstripe/mobile start"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/linux-x64",
      "@ffprobe-installer/linux-x64",
      "esbuild"
    ]
  }
}
