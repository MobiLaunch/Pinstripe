{
  "expo": {
    "name": "Pinstripe",
    "slug": "pinstripe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pinstripe",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "social.pinstripe.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2a74d6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "social.pinstripe.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2a74d6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pinstripe uses your photos and videos so you can post them.",
          "cameraPermission": "Pinstripe uses the camera so you can record videos.",
          "microphonePermission": "Pinstripe records sound with your videos."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#2a74d6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
