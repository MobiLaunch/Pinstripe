PORT=8000
# Public origin other servers use to reach this one. Must be HTTPS in production.
PINSTRIPE_ORIGIN=http://localhost:8000
# Required. Migrations run automatically at startup.
DATABASE_URL=postgres://pinstripe:pinstripe@localhost:5432/pinstripe
# Development only: let two local servers federate with each other over localhost.
# PINSTRIPE_ALLOW_PRIVATE_ADDRESS=true

# Media storage. "local" keeps files in MEDIA_DIR and serves them at /media/*.
MEDIA_STORAGE=local
MEDIA_DIR=./media-data
# Or any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO):
# MEDIA_STORAGE=s3
# S3_BUCKET=pinstripe-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_URL=https://media.pinstripe.social
# S3_FORCE_PATH_STYLE=false
# ffmpeg: a bundled static build is used unless these point at system binaries.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
