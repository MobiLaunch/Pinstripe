PORT=8000
# Public origin other servers use to reach this one. Must be HTTPS in production.
PINSTRIPE_ORIGIN=http://localhost:8000
# Postgres. Without it, everything is kept in memory and lost on restart.
# Migrations run automatically at startup.
DATABASE_URL=postgres://pinstripe:pinstripe@localhost:5432/pinstripe
# Dev only: create this local account at startup if it doesn't exist.
PINSTRIPE_SEED_ACCOUNT=sam
